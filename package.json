{
  "name": "feynman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn complex things by recursively breaking them down, then building back up.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:mock": "FEYNMAN_MOCK=1 tsx watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dompurify": "^3.4.18",
    "express": "^5.3.0",
    "katex": "^0.18.10",
    "marked": "^18.2.1",
    "marked-katex-extension": "^5.1.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vitest": "^5.1.1"
  }
}
